# ─────────────────────────────────────────────────────────────
# GIFT ML Service — Environment Variables Example
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────

# Gemini API key for LLM-powered explanations, advisor chat, and portfolio AI.
# Get yours at: https://aistudio.google.com/app/apikey
# If left blank, all LLM endpoints fall back to deterministic responses.
GEMINI_API_KEY=your_gemini_api_key

# VADER Lexicon path override (leave blank to use the default NLTK data path)
# Only needed if you installed NLTK data to a non-standard location.
VADER_LEXICON_PATH=
