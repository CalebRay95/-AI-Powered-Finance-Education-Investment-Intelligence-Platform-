# ─────────────────────────────────────────
# GIFT — Environment Variables Example
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gift

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Client (used by server for CORS)
CLIENT_URL=http://localhost:5173

# ML Microservice
ML_SERVICE_URL=http://localhost:8000

# Client-side (Vite) — prefix VITE_ to expose to the browser
VITE_API_URL=http://localhost:5000
VITE_ML_URL=http://localhost:8000

# News API (e.g. NewsAPI.org)
NEWS_API_KEY=your_newsapi_key

# Sentiment model (ml-service)
VADER_LEXICON_PATH=   # leave blank to use default NLTK path

# Stock Data API (e.g. Alpha Vantage / Yahoo Finance)
STOCK_API_KEY=your_stock_api_key

# Web3 (optional — bonus feature)
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your_project_id

# Gemini API (ml-service — LLM explanation generation)
# LLM Provider (use one)
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# C++ Core Engine binary path (optional override for CI/deployment)
CORE_ENGINE_BIN=

# Socket.IO (client-side)
VITE_SOCKET_URL=http://localhost:5000
